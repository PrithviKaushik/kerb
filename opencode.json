{
  "$schema": "https://opencode.ai/config.json",
  "model": "explabs/gpt-5.5",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 5,
            "output": 30
          }
        }
      }
    }
  }
}